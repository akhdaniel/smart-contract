<t t-name="vit_dashboard.SarlogKanwilDashboard" owl="1">
    <div class="o_sarlog_kanwil_dashboard p-3" style="height:100%; overflow:auto; background:#f5f8fb;">
        <div class="d-flex align-items-end justify-content-between mb-3">
            <div>
                <h2 class="m-0 fw-bold" style="color:#173f73;">
                    Sarlog Dashboard - Realisasi
                </h2>
                <div class="fw-semibold mt-1" style="color:#4c5f73;">
                    Rekapitulasi per kantor wilayah
                </div>
                <h4 class="m-0 mt-2 fw-bold text-uppercase" style="color:#173f73;">
                    <t t-esc="state.title"/>
                </h4>
            </div>
            <div class="d-flex gap-2 align-items-end">
                <div style="position:relative;">
                    <label class="form-label mb-1 fw-semibold d-block text-center" style="font-size:14px; color:#173f73;">Pilih Master Budget</label>
                    <input class="form-control"
                           style="min-width:260px; padding-right:34px;"
                           placeholder="-- Pilih Master Budget --"
                           t-att-value="state.masterBudgetSearchText"
                           t-on-input="onMasterBudgetInput"
                           t-on-focus="onMasterBudgetFocus"
                           t-on-blur="closeMasterBudgetDropdown"/>
                    <button type="button"
                            class="btn btn-link p-0 text-muted"
                            style="position:absolute; right:0; top:25px; width:40px; height:32px; border:1.5px solid #b8c2cf; border-radius:0 4px 4px 0; background:#f8fafc; text-decoration:none; color:#111827; display:flex; align-items:center; justify-content:center;"
                            t-on-mousedown.prevent="onMasterBudgetToggleDropdown">
                        <span style="display:inline-block; width:8px; height:8px; border-right:1.75px solid currentColor; border-bottom:1.75px solid currentColor; transform:rotate(45deg); margin-top:-4px;"/>
                    </button>
                    <div t-if="state.masterBudgetDropdownOpen"
                         class="bg-white border shadow-sm"
                         style="position:absolute; z-index:30; top:100%; left:0; right:0; max-height:220px; overflow:auto;">
                        <t t-if="filteredMasterBudgets.length">
                            <t t-foreach="filteredMasterBudgets" t-as="mb" t-key="mb.id">
                                <button type="button"
                                        class="dropdown-item text-start"
                                        t-att-data-id="mb.id"
                                        t-on-mousedown.prevent="selectMasterBudgetFromEvent">
                                    <t t-esc="mb.name"/>
                                </button>
                            </t>
                        </t>
                        <div t-if="!filteredMasterBudgets.length" class="px-3 py-2 text-muted">
                            Tidak ada data
                        </div>
                    </div>
                </div>
                <div>
                    <label class="form-label mb-1 fw-semibold d-block text-center" style="font-size:14px; color:#173f73;">Pilih Tahun</label>
                    <select class="form-select" style="width:130px;" t-on-change="onYearChange">
                        <t t-foreach="state.availableYears" t-as="year" t-key="year">
                            <option t-att-value="year"
                                    t-att-selected="state.selectedYear === year ? true : undefined">
                                <t t-esc="year"/>
                            </option>
                        </t>
                    </select>
                </div>
            </div>
        </div>

        <div class="bg-white border" style="overflow:auto;">
            <table class="table table-sm mb-0" style="font-size:12px; min-width:1180px; border-collapse:collapse;">
                <thead style="position:sticky; top:0; z-index:2;">
                    <tr style="background:#e8f4fb; color:#173f73; border-top:4px solid #34b5d7;">
                        <th rowspan="2" class="align-middle text-center border">KANWIL</th>
                        <th rowspan="2" class="align-middle text-center border">Sisa Pembayaran<br/><t t-esc="state.selectedYear - 1"/></th>
                        <th colspan="2" class="text-center border">Izin Prinsip <t t-esc="state.selectedYear"/></th>
                        <th colspan="3" class="text-center border">TL Izin Prinsip <t t-esc="state.selectedYear"/></th>
                        <th colspan="3" class="text-center border">Realisasi</th>
                    </tr>
                    <tr style="background:#e8f4fb; color:#173f73;">
                        <th class="text-center border">Qty</th>
                        <th class="text-center border">Pagu</th>
                        <th class="text-center border">Belum</th>
                        <th class="text-center border">Sudah</th>
                        <th class="text-center border">%</th>
                        <th class="text-center border">Kontrak</th>
                        <th class="text-center border">Droping/Relok</th>
                        <th class="text-center border">%</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-if="state.isLoading">
                        <td colspan="10" class="text-center py-5 text-muted">Loading...</td>
                    </tr>
                    <tr t-if="!state.isLoading &amp;&amp; !state.rows.length">
                        <td colspan="10" class="text-center py-5 text-muted">Tidak ada data</td>
                    </tr>
                    <t t-foreach="state.rows" t-as="row" t-key="row.kanwil">
                        <tr>
                            <td class="fw-semibold text-uppercase border" style="color:#0b73ad;">
                                <t t-esc="row.kanwil"/>
                            </td>
                            <td class="text-end border"><t t-esc="row.previous_payment_fmt"/></td>
                            <td class="text-end border"><t t-esc="row.ip_qty"/></td>
                            <td class="text-end border"><t t-esc="row.ip_pagu_fmt"/></td>
                            <td class="text-end border"><t t-esc="row.tl_belum"/></td>
                            <td class="text-end border"><t t-esc="row.tl_sudah"/></td>
                            <td class="text-end border"><t t-esc="row.tl_percent.toFixed(2)"/>%</td>
                            <td class="text-end border"><t t-esc="row.contract_fmt"/></td>
                            <td class="text-end border"><t t-esc="row.droping_fmt"/></td>
                            <td class="text-end border"><t t-esc="row.droping_percent.toFixed(2)"/>%</td>
                        </tr>
                    </t>
                    <tr t-if="!state.isLoading" style="background:#eef7df; font-weight:700;">
                        <td class="text-center border">JUMLAH</td>
                        <td class="text-end border"><t t-esc="state.totals.previous_payment_fmt"/></td>
                        <td class="text-end border"><t t-esc="state.totals.ip_qty"/></td>
                        <td class="text-end border"><t t-esc="state.totals.ip_pagu_fmt"/></td>
                        <td class="text-end border"><t t-esc="state.totals.tl_belum"/></td>
                        <td class="text-end border"><t t-esc="state.totals.tl_sudah"/></td>
                        <td class="text-end border"><t t-esc="state.totals.tl_percent.toFixed(2)"/>%</td>
                        <td class="text-end border"><t t-esc="state.totals.contract_fmt"/></td>
                        <td class="text-end border"><t t-esc="state.totals.droping_fmt"/></td>
                        <td class="text-end border"><t t-esc="state.totals.droping_percent.toFixed(2)"/>%</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</t>
