<t t-name="vit_dashboard.KetersediaanDashboard" owl="1">
    <div class="o_rkap_dashboard o_ketersediaan_dashboard">
        <div class="o_rkap_dashboard__toolbar">
            <div>
                <h2>Dashboard Ketersediaan</h2>
                <p>Rekap ketersediaan Sarlog</p>
            </div>
            <div class="o_rkap_dashboard__actions">
                <div class="o_rkap_dashboard__year">
                    <label for="ketersediaan-dashboard-year">Tahun</label>
                    <select id="ketersediaan-dashboard-year" class="form-select"
                            t-on-change="onYearChange" t-att-disabled="state.isLoading ? true : undefined">
                        <t t-foreach="state.availableYears" t-as="year" t-key="year">
                            <option t-att-value="year" t-att-selected="state.selectedYear === year ? true : undefined">
                                <t t-esc="year"/>
                            </option>
                        </t>
                    </select>
                </div>
                <button type="button" class="btn btn-primary o_rkap_dashboard__download"
                        t-on-click="downloadDashboard"
                        t-att-disabled="state.isLoading || state.isDownloading ? true : undefined">
                    <i t-att-class="state.isDownloading ? 'fa fa-spinner fa-spin' : 'fa fa-download'"/>
                    <span><t t-esc="state.isDownloading ? 'Menyiapkan...' : 'Download Dashboard'"/></span>
                </button>
            </div>
        </div>

        <div class="o_rkap_dashboard__sheet">
            <div class="o_rkap_dashboard__title"><t t-esc="state.title"/></div>
            <div class="o_rkap_dashboard__table_wrap">
                <table class="o_rkap_dashboard__table o_ketersediaan_dashboard__table">
                    <thead>
                        <tr>
                            <th rowspan="2" class="o_col_no">NO</th>
                            <th rowspan="2" class="o_col_activity">KEGIATAN</th>
                            <th>RKAP</th>
                            <th>SISA PEMBAYARAN<br/><t t-esc="state.previousYear"/></th>
                            <th>IZIN PRINSIP TERBIT<br/><t t-esc="state.selectedYear"/></th>
                            <th>SISA SALDO</th>
                        </tr>
                        <tr><th>(Rp)</th><th>(Rp)</th><th>(Rp)</th><th>(Rp)</th></tr>
                    </thead>
                    <tbody>
                        <tr t-if="state.isLoading">
                            <td colspan="6" class="o_rkap_dashboard__empty"><i class="fa fa-spinner fa-spin"/> Memuat data...</td>
                        </tr>
                        <t t-foreach="state.categories" t-as="category" t-key="category.key">
                            <tr t-att-class="'o_rkap_category o_rkap_category--' + category.key">
                                <td><t t-esc="category.letter"/></td><td><t t-esc="category.name"/></td><td colspan="4"/>
                            </tr>
                            <t t-foreach="category.items" t-as="item" t-key="category.key + '-' + item.number">
                                <tr t-att-class="'o_rkap_data o_rkap_data--' + category.key">
                                    <td class="o_text_center"><t t-esc="item.number"/></td>
                                    <td class="o_text_left"><t t-esc="item.name"/></td>
                                    <td><t t-esc="formatAmount(item.rkap)"/></td>
                                    <td><t t-esc="formatAmount(item.sisa_pembayaran)"/></td>
                                    <td><t t-esc="formatAmount(item.izin_terbit)"/></td>
                                    <td t-att-class="item.saldo &lt; 0 ? 'o_ketersediaan_negative' : ''"><t t-esc="formatAmount(item.saldo)"/></td>
                                </tr>
                            </t>
                            <tr t-att-class="'o_rkap_subtotal o_rkap_subtotal--' + category.key">
                                <td/><td>JUMLAH <t t-esc="category.name"/></td>
                                <td><t t-esc="formatAmount(category.totals.rkap)"/></td>
                                <td><t t-esc="formatAmount(category.totals.sisa_pembayaran)"/></td>
                                <td><t t-esc="formatAmount(category.totals.izin_terbit)"/></td>
                                <td t-att-class="category.totals.saldo &lt; 0 ? 'o_ketersediaan_negative' : ''"><t t-esc="formatAmount(category.totals.saldo)"/></td>
                            </tr>
                        </t>
                        <tr t-if="!state.isLoading" class="o_rkap_grand_total">
                            <td/><td>TOTAL</td>
                            <td><t t-esc="formatAmount(state.totals.rkap)"/></td>
                            <td><t t-esc="formatAmount(state.totals.sisa_pembayaran)"/></td>
                            <td><t t-esc="formatAmount(state.totals.izin_terbit)"/></td>
                            <td><t t-esc="formatAmount(state.totals.saldo)"/></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</t>
