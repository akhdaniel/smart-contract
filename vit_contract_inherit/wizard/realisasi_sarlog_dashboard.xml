<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Wizard Form View -->
        <record id="view_wizard_realisasi_sarlog_dashboard_form" model="ir.ui.view">
            <field name="name">wizard.realisasi.sarlog.dashboard.form</field>
            <field name="model">wizard.realisasi.sarlog.dashboard</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Realisasi Sarlog Dashboard">
                    <group>
                        <field name="year"/>
                    </group>
                    <footer>
                        <button name="action_export_excel" type="object" string="Export Excel" class="oe_highlight"/>
                        <button string="Cancel" class="oe_link" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action untuk membuka wizard -->
        <record id="action_wizard_realisasi_sarlog_dashboard" model="ir.actions.act_window">
            <field name="name">Realisasi Sarlog Dashboard</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">wizard.realisasi.sarlog.dashboard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <delete id="vit_contract_menu_realisasi_sarlog_dashboard" model="ir.ui.menu"/>
    </data>
</odoo>
