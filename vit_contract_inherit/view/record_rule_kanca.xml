<odoo>
    <data>

        <record id="vit_izin_prinsip_kanca_rule" model="ir.rule">
            <field name="name">Izin Prinsip - Multi Kanca &amp; Kanwil</field>
            <field name="model_id" ref="vit_contract.model_vit_izin_prinsip"/>
            <field name="groups" eval="[(4, ref('vit_contract_inherit.group_vit_contract_kanca'))]"/>
            <field name="domain_force">[('job_izin_prinsip_ids.kanca_id', 'in', user.multi_kanca.ids)]</field>
        </record>


        <record id="vit_kontrak_kanca_rule" model="ir.rule">
            <field name="name">Kontrak - Multi Kanca &amp; Kanwil</field>
            <field name="model_id" ref="vit_contract.model_vit_kontrak"/>
            <field name="groups" eval="[(4, ref('vit_contract_inherit.group_vit_contract_kanca'))]"/>
            <field name="domain_force">
                [
                    ('kanca_id', 'in', user.multi_kanca.ids),
                    ('kanwil_id', 'in', user.multi_kanwil.ids)
                ]
            </field>
        </record>

        <record id="vit_termin_kanca_rule" model="ir.rule">
            <field name="name">Termin - Multi Kanca &amp; Kanwil</field>
            <field name="model_id" ref="vit_contract.model_vit_termin"/>
            <field name="groups" eval="[(4, ref('vit_contract_inherit.group_vit_contract_kanca'))]"/>
            <field name="domain_force">
                [
                    ('kontrak_id.kanca_id', 'in', user.multi_kanca.ids),
                    ('kontrak_id.kanwil_id', 'in', user.multi_kanwil.ids)
                ]
            </field>
        </record>

        <record id="vit_droping_kanca_rule" model="ir.rule">
            <field name="name">Droping - Multi Kanca &amp; Kanwil</field>
            <field name="model_id" ref="vit_contract.model_vit_droping"/>
            <field name="groups" eval="[(4, ref('vit_contract_inherit.group_vit_contract_kanca'))]"/>
            <field name="domain_force">
                [
                    ('kanwil_id', 'in', user.multi_kanwil.ids)
                ]
            </field>
        </record>

        <record id="vit_master_users_kanca_rule" model="ir.rule">
            <field name="name">Master Users - Multi Kanca Only</field>
            <field name="model_id" ref="vit_contract.model_vit_master_users"/>
            <field name="groups" eval="[(4, ref('vit_contract_inherit.group_vit_contract_kanca'))]"/>
            <field name="domain_force">['|', ('kanca_vendor', 'in', user.multi_kanca.ids), ('kanwil_vendor', 'in', user.multi_kanwil.ids)]</field>
        </record>

        <record id="vit_kompleks_pergudangan_kanca_rule" model="ir.rule">
            <field name="name">Kompleks Pergudangan - Multi Kanca Only</field>
            <field name="model_id" ref="vit_contract.model_vit_kompleks_pergudangan"/>
            <field name="groups" eval="[(4, ref('vit_contract_inherit.group_vit_contract_kanca'))]"/>
            <field name="domain_force">[('kanca_id', 'in', user.multi_kanca.ids)]</field>
        </record>

        <record id="vit_kontrak_attachment_kanca_rule" model="ir.rule">
            <field name="name">Dokumen Kontrak - Multi Kanca Only</field>
            <field name="model_id" ref="model_vit_kontrak_attachment"/>
            <field name="groups" eval="[(4, ref('vit_contract_inherit.group_vit_contract_kanca'))]"/>
            <field name="domain_force">[('kontrak_id.kanca_id', 'in', user.multi_kanca.ids)]</field>
        </record>

    </data>
</odoo>
